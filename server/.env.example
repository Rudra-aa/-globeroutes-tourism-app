# Server Configuration
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/globeroutes
JWT_SECRET=your_jwt_secret_key_here

# OpenRouteService (Driving, Walking, Cycling Routes & Geocoding)
# Sign up at: https://openrouteservice.org
ORS_API_KEY=

# OpenWeather API (Current Weather, Forecasts, Weather Alerts)
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Amadeus Travel API (Flight Search, Airport Lookups, Live Fares)
# Sign up at: https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test # 'test' for sandbox, 'production' for live

# Unsplash API (Destination Photography)
# Sign up at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# GeoNames API (Geographic Database & Country Intelligence)
# Sign up at: https://www.geonames.org
GEONAMES_USERNAME=

# Groq AI (Optional: Aura Conversational Model)
# Sign up at: https://groq.com
GROQ_API_KEY=
